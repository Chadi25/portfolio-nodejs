# ===================================================
# CONFIGURATION DU CHATBOT IA DU PORTFOLIO
# ===================================================

# 1. OPTION RECOMMANDÉE : Google Gemini API (100% GRATUIT, 1500 requêtes/jour, ultra-rapide)
# Obtenir une clé gratuite en 30 secondes : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OPTION SECONDAIRE : OpenRouter API (modèles gratuits : openrouter/free)
# Obtenir une clé : https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 3. OPTION ALTERNATIVE : Groq API (ultra-rapide avec Llama 3.3 70B)
# Obtenir une clé : https://console.groq.com/keys
GROQ_API_KEY=

# Port du serveur local (3000 par défaut)
PORT=3000
