        <!-- Projet 4 - Stage JTEKT Teleport -->
        <div class="project">
            <div class="project-content">
                <div class="comment">// Projet 04</div>
                <h2 class="title">Stage JTEKT<br>Bastion Teleport CE<br>& Intégration AD</h2>
                <p class="description">
                    <strong>Contexte :</strong> Centralisation des accès Windows/Linux via une architecture Zero Trust à
                    certificats éphémères.
                </p>

                <div class="contribution">
                    <h4>Détails techniques :</h4>
                    <ul>
