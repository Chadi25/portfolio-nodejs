<div class="resume-container">
    <div class="resume-header">
        <h2 class="stylish-title"><%= __('resume.title') %></h2>
        <div class="document-buttons">
            <button class="view-btn" onclick="showDocument('CV_Chadi_Abouhaik.pdf', '<%= __('resume.view_cv') %>')"><%= __('resume.view_cv') %></button>
            <button class="view-btn" onclick="showDocument('livret_competences.pdf', '<%= __('resume.view_livret') %>')"><%= __('resume.view_livret') %></button>
        </div>
    </div>
    
    <div class="resume-content">
        <object
            id="pdfViewer"
            data="/documents/CV_Chadi_Abouhaik.pdf"
            type="application/pdf"
            width="100%"
            height="100%">
            <p><%= __('resume.no_pdf') %> <a href="/documents/CV_Chadi_Abouhaik.pdf"><%= __('resume.download') %></a></p>
        </object>
    </div>
</div>

<!-- Modal pour afficher les documents -->
<div id="documentModal" class="modal">
    <div class="modal-content">
        <span class="close-btn">&times;</span>
        <h3 id="modalTitle">Document</h3>
        <iframe id="documentViewer" width="100%" height="100%"></iframe>
    </div>
</div>