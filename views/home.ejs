<div class="terminal-intro" id="terminal-intro">
    <div class="terminal-container">
        <div class="terminal-header">
            <div class="terminal-button red"></div>
            <div class="terminal-button yellow"></div>
            <div class="terminal-button green"></div>
        </div>
        <div class="terminal-content">
            <div class="terminal-line">
                <span id="typing-text"></span>
                <span class="cursor"></span>
            </div>
            <div class="terminal-welcome hidden">
                <p class="welcome-text"><%= __('home.welcome') %></p>
            </div>
        </div>
    </div>
</div>

<div class="home-content" id="main-content" style="display: none;">
    <div class="ascii-art">
        {" " }
    </div>
    <div class="intro-text">
        <h1><%= __('home.hello') %></h1>
        <div class="typing-text"><%= __('home.typing_default') %></div>
        <p class="comment"><%= __('home.passion') %></p>
        <div class="scroll-indicator">
            <span><%= __('home.scroll') %></span>
            <div class="arrow">↓</div>
        </div>
    </div>
</div>

<script>
    window.TYPING_TEXTS = [
        "<%= __('home.typing1') %>",
        "<%= __('home.typing2') %>",
        "<%= __('home.typing3') %>"
    ];
</script>
